# 本番(VPS)用。コピーして /opt/circleboard/.env.production を作る:
#   cp .env.production.example .env.production
#
# .env.* は .gitignore 済み。**実値をコミットしないこと(CLAUDE.md §3-6)。**
# このファイルはサーバー上で chmod 600 にしておく。DBのパスワードが入る。

# --- PostgreSQL (db サービス) ---
# パスワードは手で考えず、その場で作る:
#   openssl rand -hex 24
#
# -base64 ではなく -hex にしているのは、/ や + が混ざると下の DATABASE_URL の
# パスワード部分でURLの区切りと衝突するため。hex なら 0-9a-f しか出ない
POSTGRES_USER=circleboard
POSTGRES_PASSWORD=ここに生成した値
POSTGRES_DB=circleboard_production

# --- Rails (backend サービス) ---
# db は Compose のサービス名。コンテナ間で名前解決される。
# パスワードは POSTGRES_PASSWORD と同じ値にする(2か所に書くことになる)
DATABASE_URL=postgres://circleboard:ここに生成した値@db:5432/circleboard_production

# セッションCookieの署名鍵。これが変わると全員ログアウトになる。
#   openssl rand -hex 64
#
# サーバーの上で作る。openssl は Ubuntu に最初から入っているので、
# このためにイメージを1つ落とす必要はない
#
# credentials.yml.enc にも secret_key_base は入っているが、**本番はこちらを使う。**
# あちらは環境で分かれておらず、開発機の master.key で開く同じ鍵を本番でも
# 使うことになる。開発機が1台盗まれただけで本番のセッションを偽造できる状態を
# 作りたくないので、本番用の鍵はこのサーバーの中だけで生成する。
# (Rails は production で ENV["SECRET_KEY_BASE"] を credentials より先に見る)
SECRET_KEY_BASE=ここに生成した値

# APIへのアクセスを許可するオリジン(カンマ区切り)。ワイルドカードは使わない。
#
# **本番はフロントとAPIが同じオリジンなので、本来ここは空で足りる。**
# 同一オリジンのリクエストに CORS は関わらない。将来フロントを別ホストに
# 置いたときだけ書く。
CORS_ALLOWED_ORIGINS=

# サイネージのQRコードに載せるURL。サーバー側で組み立てる(api-spec.md §6)。
# **未設定だと起動後にサイネージだけが 500 になる**(ENV.fetch に既定値が無い)。
# 管理画面のトークン一覧も同じ所を踏むので、そちらも落ちる
PUBLIC_BASE_URL=https://cb.fukupro.club

# Host ヘッダの検査(spec-v2.2.md §7.5)。ここに書いた宛先以外は 403 になる。
# 複数書くならカンマ区切り。IP直打ちを許したくないのでドメインだけにしている
ALLOWED_HOSTS=cb.fukupro.club

# HTTPSを強制するか。**既定は true なので、通常はこの行を書かない。**
# 書くのは、ドメインがまだ無くて IP 直打ち(http)で動かす期間だけ。
# 証明書を出せないホストで true にすると https へ飛ばされ、
# ブラウザの警告で画面まで辿り着けない
# FORCE_SSL=false

# --- Caddy (frontend サービス) ---
# ドメイン名を書くと Caddy が証明書を自動取得・自動更新する(§7.3)。
# **DNS がこのサーバーを指してから書くこと。** 指していない状態で起動すると
# 取得に失敗し、Let's Encrypt のレート制限(同一ドメイン週5回)を消費する。
# ドメインが無い間は :80 と書く(ホスト名を問わず80番で待つ。IP直打ちでも届く)
SITE_ADDRESS=cb.fukupro.club

# --- イメージ (§7.4) ---
# VPS ではビルドしない。ここに書いたイメージを pull して動かす。
# 切り戻すときはタグをひとつ前の SHA に書き換えて up -d する
BACKEND_IMAGE=ghcr.io/rengemaru/circleboard-backend:latest
FRONTEND_IMAGE=ghcr.io/rengemaru/circleboard-frontend:latest
