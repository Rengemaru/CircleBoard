# 開発用イメージ。本番は Phase 5 (D-3) で React をビルドし Caddy が静的配信する。
FROM node:22-bookworm-slim

WORKDIR /app

EXPOSE 5173

# T1-1 時点では frontend/ が空のため、Vite 生成前でもコンテナが落ちないようにする。
# T1-3 で npm create vite を実行すると package.json が現れ、以降は自動的に dev サーバが起動する。
# --host: コンテナ外(ホストのブラウザ)からアクセスできるように 0.0.0.0 で待ち受ける
CMD ["bash", "-c", "if [ -f package.json ]; then npm run dev -- --host 0.0.0.0; else echo '[T1-1] Vite app not generated yet. Waiting.'; sleep infinity; fi"]
