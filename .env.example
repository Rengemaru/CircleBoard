# このファイルをコピーして .env を作る:  cp .env.example .env
# .env は .gitignore 済み。実値をコミットしないこと(CLAUDE.md §3-6)。

# --- PostgreSQL (db サービス) ---
POSTGRES_USER=circleboard
POSTGRES_PASSWORD=development_password
POSTGRES_DB=circleboard_development

# --- Rails (backend サービス) ---
# ホスト名 db は docker-compose.yml のサービス名。コンテナ間で名前解決される。
DATABASE_URL=postgres://circleboard:development_password@db:5432/circleboard_development

# テスト用DB。development とは別のデータベースを使う(RSpec 導入は T1-7)。
TEST_DATABASE_URL=postgres://circleboard:development_password@db:5432/circleboard_test

# APIへのアクセスを許可するオリジン(カンマ区切り)。ワイルドカードは使わない。
# 値はブラウザがフロントを開くURL。ホスト側ポートを変えたらここも合わせる。
CORS_ALLOWED_ORIGINS=http://localhost:5173

# 開発中に LAN の別端末(スマホ・部室のディスプレイなど)から触るためのスイッチ。
# true にすると、プライベートIP(10./172.16-31./192.168./localhost)からの
# アクセスをまとめて許す。端末ごとにIPを書き足さずに済む。
# 本番では必ず false のままにして、CORS_ALLOWED_ORIGINS で明示する。
CORS_ALLOW_PRIVATE_NETWORK=true

# サイネージの detail_url をサーバー側で組み立てるのに使う。
# フロントでURLを組み立てない(サイネージ端末の設定に依存させないため)。
#
# ここだけは自動で決められない。LAN の別端末で QR を読ませたいときは
# http://192.168.x.x:5173 のように、その端末から見えるURLを入れる。
PUBLIC_BASE_URL=http://localhost:5173

# --- React / Vite (frontend サービス) ---
# ブラウザから見たAPIのURL。
#
# 空にすると「いま開いている画面と同じホストの :3000」を見る。
# LAN の別端末から 192.168.x.x で開いても、その端末の localhost を
# 指さずに済むので、開発中は空のままにしておく。
# 本番は必ず明示する。
VITE_API_BASE_URL=
# APIのポート。VITE_API_BASE_URL が空のときだけ使う(既定 3000)。
# BACKEND_HOST_PORT を変えたときだけ合わせる。
VITE_API_PORT=3000
# QRコードに載せる、このサイト自身の公開URL。
# 空にすると、サイネージを開いている URL をそのまま使う。
VITE_PUBLIC_BASE_URL=

# --- ホスト側ポート(任意) ---
# 同じPC上の別プロジェクトとポートが衝突する場合だけ変更する。
# コンテナ内のポートは変わらない(backend:3000 / frontend:5173)。
BACKEND_HOST_PORT=3000
FRONTEND_HOST_PORT=5173
